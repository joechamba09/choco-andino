---
// src/components/AprendeModal.astro
// Modal interactivo del Asistente Educativo IA para el Chocó Andino
const ic = {
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c2 2 2.6 3.5 3.7 9.2A7 7 0 0 1 11 20z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/><path d="M12 11c-2 2-3 4-3 6"/>',
  trash: '<path d="M3 6h18"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M8 6V4h8v2"/>'
};
---

<!-- MODAL / CHAT INTERACTIVO ASISTENTE IA -->
<div 
  id="aprendeModal" 
  class="fixed inset-0 z-50 bg-black/60 backdrop-blur-md hidden flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="aprendeModalTitle"
>
  <div class="bg-white border border-emerald-200 rounded-[32px] max-w-2xl w-full p-4 sm:p-6 relative shadow-2xl flex flex-col h-[85vh] max-h-[750px] overflow-hidden">
    
    {/* Cabecera del Chat */}
    <div class="flex justify-between items-center pb-4 border-b border-emerald-100 gap-2">
      <div class="flex items-center gap-3.5 min-w-0">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white text-xl shadow-lg shadow-emerald-600/30 shrink-0">
          🐾
        </div>
        <div class="min-w-0">
          <h2 id="aprendeModalTitle" class="text-base md:text-lg font-black text-[var(--color-ink,#1b2a22)] flex items-center gap-2">
            Asistente IA del Chocó Andino 
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent,#d4a63a)] animate-pulse shrink-0"></span>
          </h2>
          <p class="text-xs text-[var(--color-secondary,#2e7d52)] font-bold">Explora la biodiversidad y aprende sobre la reserva</p>
        </div>
      </div>
      
      <div class="flex items-center gap-2 shrink-0">
        <button 
          id="clearChat" 
          type="button"
          title="Reiniciar chat" 
          class="cho-btn text-zinc-500 hover:text-red-600 text-xs font-bold bg-emerald-50 px-3 py-2 rounded-xl border border-emerald-200 cursor-pointer transition-colors flex items-center gap-1 shadow-sm min-h-[40px]"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ic.trash}></svg> 
          <span>Limpiar</span>
        </button>
        <button 
          id="closeAprende" 
          type="button"
          aria-label="Cerrar ventana del asistente" 
          class="cho-btn text-zinc-500 hover:text-zinc-900 text-lg font-black bg-emerald-50 w-10 h-10 rounded-xl flex items-center justify-center border border-emerald-200 cursor-pointer transition-colors shadow-sm"
        >
          &times;
        </button>
      </div>
    </div>

    {/* Historial de Mensajes del Chat */}
    <div id="chatMessages" class="flex-grow overflow-y-auto py-4 space-y-4 pr-2 scroll-smooth">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-2xl bg-emerald-700 flex items-center justify-center text-white text-xs shrink-0 shadow-md">🌿</div>
        <div class="bg-emerald-50/80 border border-emerald-200 p-4 rounded-2xl rounded-tl-sm text-sm text-zinc-800 max-w-[85%] leading-relaxed shadow-sm">
          ¡Hola! Soy tu asistente del Chocó Andino 🌿 Puedo contarte sobre las especies del catálogo, la reserva y cómo protegerla. Elige una sugerencia o escribe tu pregunta.
        </div>
      </div>

      {/* Sugerencias Rápidas Iniciales */}
      <div class="flex flex-wrap gap-2 pl-12 pt-1 pb-2">
        <button type="button" class="quick-prompt cho-btn bg-white hover:bg-emerald-600 hover:text-white text-emerald-800 border border-emerald-200 text-xs font-bold px-3.5 py-2 rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer" data-pregunta="¿Dónde vive el oso de anteojos y de qué se alimenta?">
          <span>🐾</span> Oso de anteojos
        </button>
        <button type="button" class="quick-prompt cho-btn bg-white hover:bg-emerald-600 hover:text-white text-emerald-800 border border-emerald-200 text-xs font-bold px-3.5 py-2 rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer" data-pregunta="¿Qué aves podemos encontrar en el Chocó Andino?">
          <span>🕊️</span> Aves del Chocó
        </button>
        <button type="button" class="quick-prompt cho-btn bg-white hover:bg-emerald-600 hover:text-white text-emerald-800 border border-emerald-200 text-xs font-bold px-3.5 py-2 rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer" data-pregunta="¿Qué plantas son importantes en este ecosistema?">
          <span>🌸</span> Flora y plantas
        </button>
        <button type="button" class="quick-prompt cho-btn bg-white hover:bg-emerald-600 hover:text-white text-emerald-800 border border-emerald-200 text-xs font-bold px-3.5 py-2 rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer" data-pregunta="¿Cómo podemos ayudar a proteger el Chocó Andino?">
          <span>🛡️</span> Conservación
        </button>
        <button type="button" class="quick-prompt cho-btn bg-white hover:bg-emerald-600 hover:text-white text-emerald-800 border border-emerald-200 text-xs font-bold px-3.5 py-2 rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer" data-pregunta="¿Qué mamíferos habitan en la reserva?">
          <span>🐾</span> Mamíferos
        </button>
        <button type="button" class="quick-prompt cho-btn bg-white hover:bg-emerald-600 hover:text-white text-emerald-800 border border-emerald-200 text-xs font-bold px-3.5 py-2 rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer" data-pregunta="¿Qué anfibios viven en la reserva?">
          <span>🐸</span> Anfibios
        </button>
        <button type="button" class="quick-prompt cho-btn bg-white hover:bg-emerald-600 hover:text-white text-emerald-800 border border-emerald-200 text-xs font-bold px-3.5 py-2 rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer" data-pregunta="¿Qué insectos puedo encontrar en el Chocó Andino?">
          <span>🦋</span> Insectos
        </button>
      </div>
    </div>

    {/* Entrada de Texto y Envío */}
    <div class="pt-3 border-t border-emerald-100 flex gap-2.5 items-center">
      <div class="relative flex-grow">
        <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-[var(--color-secondary,#2e7d52)]">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ic.leaf}></svg>
        </span>
        <input 
          type="text" 
          id="chatInput" 
          placeholder="Escribe tu pregunta sobre el Chocó Andino..." 
          class="w-full bg-zinc-50 border border-emerald-200/80 rounded-2xl pl-11 pr-4 py-3.5 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-emerald-500 focus:bg-white transition-all shadow-inner"
        />
      </div>
      <button 
        id="sendChat" 
        type="button"
        class="cho-btn bg-[#0b3824] hover:bg-[var(--color-secondary,#2e7d52)] text-white px-5 sm:px-6 py-3.5 rounded-2xl font-black text-sm transition-colors shadow-lg shadow-emerald-950/20 cursor-pointer flex items-center gap-2 shrink-0"
      >
        <span>Enviar</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </button>
    </div>

  </div>
</div>
