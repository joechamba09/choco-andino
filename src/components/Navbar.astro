---
// src/components/Navbar.astro
// Barra de navegación principal del Chocó Andino
// Opciones: Aprende | Catálogo | Panel de administrador

const ic = {
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c2 2 2.6 3.5 3.7 9.2A7 7 0 0 1 11 20z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/><path d="M12 11c-2 2-3 4-3 6"/>',
  sparkles: '<path d="M9.9 2.9 11 6.7a2 2 0 0 0 1.3 1.3l3.8 1.1-3.8 1.1a2 2 0 0 0-1.3 1.3l-1.1 3.8-1.1-3.8a2 2 0 0 0-1.3-1.3L3.7 9.1 7.5 8a2 2 0 0 0 1.3-1.3z"/><path d="M19 14v4"/><path d="M17 16h4"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>'
};
---

<!-- Barra Superior Institucional (Informativa y Educativa) -->
<div class="w-full bg-[var(--color-deep,#14301f)] border-b border-emerald-900/30 py-2 px-4 sm:px-6 md:px-12 text-xs text-emerald-100 flex flex-wrap justify-between items-center z-30 shadow-sm gap-2">
  <div class="flex items-center gap-2 font-medium">
    <span class="inline-flex items-center gap-1.5 text-emerald-200">
      <svg class="w-3.5 h-3.5 text-[var(--color-accent,#d4a63a)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ic.leaf}></svg>
      <span class="font-bold">Proyecto Educativo de Biodiversidad</span>
    </span>
    <span class="text-emerald-700 hidden sm:inline">•</span>
    <span class="text-emerald-300/80 hidden sm:inline">Chocó Andino de Pichincha</span>
  </div>
  
  <div class="flex items-center gap-2 text-[11px] font-semibold text-emerald-200">
    <span class="w-2 h-2 rounded-full bg-[var(--color-accent,#d4a63a)] animate-pulse"></span>
    <span class="uppercase tracking-wider">Reserva de Biosfera UNESCO</span>
    <span class="text-emerald-600 hidden md:inline">•</span>
    <span class="text-white hidden md:inline">Ecuador</span>
  </div>
</div>

<!-- Cabecera de Navegación Principal -->
<header class="w-full bg-[var(--color-primary,#1e4d36)] text-white border-b border-emerald-600/40 py-3.5 px-4 sm:px-6 md:px-12 lg:px-16 sticky top-0 z-40 shadow-xl relative overflow-hidden">
  
  {/* Siluetas de hojas botánicas decorativas en el fondo */}
  <div class="absolute inset-0 pointer-events-none z-0 opacity-20 overflow-hidden flex justify-between items-center" aria-hidden="true">
    <svg class="w-64 h-full -ml-10 text-emerald-400" viewBox="0 0 200 100" fill="currentColor">
      <path d="M0 100 C 40 80, 60 40, 90 10 C 110 50, 130 80, 180 100 Z" />
      <path d="M20 90 C 50 70, 70 30, 110 0 C 120 40, 140 70, 190 100 Z" opacity="0.7" />
    </svg>
    <svg class="w-64 h-full -mr-10 text-emerald-400 transform scale-x-[-1]" viewBox="0 0 200 100" fill="currentColor">
      <path d="M0 100 C 40 80, 60 40, 90 10 C 110 50, 130 80, 180 100 Z" />
      <path d="M20 90 C 50 70, 70 30, 110 0 C 120 40, 140 70, 190 100 Z" opacity="0.7" />
    </svg>
  </div>

  <div class="max-w-7xl mx-auto flex justify-between items-center relative z-10">
    
    {/* Logotipo e Identidad Visual */}
    <a href="/" class="flex items-center gap-3 sm:gap-4 group focus:outline-none" aria-label="Inicio Chocó Andino">
      <div class="relative w-11 h-11 sm:w-12 sm:h-12 bg-gradient-to-br from-emerald-400 to-teal-600 rounded-[22px_8px_22px_8px] shadow-lg shadow-emerald-950/50 flex items-center justify-center transform group-hover:rotate-6 transition-transform border border-emerald-300/40">
        <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white drop-shadow-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.leaf}></svg>
      </div>

      <div class="h-8 w-[1px] bg-emerald-500/50 hidden sm:block"></div>

      <div class="flex flex-col">
        <span class="text-lg sm:text-xl md:text-2xl font-black tracking-wider text-white drop-shadow">CHOCÓ ANDINO</span>
        <span class="text-[9px] uppercase tracking-widest text-emerald-300 font-bold hidden sm:block">Pichincha &bull; Ecuador</span>
      </div>
    </a>

    {/* Navegación Principal para Computadoras y Tablets */}
    <nav class="hidden md:flex items-center gap-3 lg:gap-4 text-sm font-bold" aria-label="Menú principal de navegación">
      
      {/* 1. Opción APRENDE */}
      <button 
        type="button"
        id="openAprende" 
        class="cho-btn hover:text-white transition-all cursor-pointer bg-emerald-900/60 hover:bg-emerald-800 border border-emerald-600/50 px-4 py-2.5 rounded-2xl text-emerald-100 font-bold text-xs sm:text-sm flex items-center gap-2 group shadow-md min-h-[44px]"
      >
        <span class="p-1 rounded-lg bg-emerald-700 text-[var(--color-accent,#d4a63a)] group-hover:bg-[var(--color-accent,#d4a63a)] group-hover:text-[var(--color-deep,#14301f)] transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.sparkles}></svg>
        </span>
        <span>Aprende</span>
      </button>

      {/* 2. Opción CATÁLOGO */}
      <a 
        href="#catalogo" 
        class="cho-btn hover:text-white transition-all flex items-center gap-2 bg-emerald-900/40 hover:bg-emerald-800 border border-emerald-600/40 px-4 py-2.5 rounded-2xl shadow-md text-xs sm:text-sm min-h-[44px] text-emerald-100"
      >
        <span class="p-1 rounded-lg bg-emerald-700 text-emerald-200">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.leaf}></svg>
        </span>
        <span>Catálogo</span>
      </a>

      {/* 3. ÚNICA OPCIÓN: PANEL DE ADMINISTRADOR */}
      <a 
        href="/admin" 
        class="cho-btn hover:text-white transition-all flex items-center gap-2 bg-gradient-to-r from-emerald-900/90 to-teal-900/90 hover:from-emerald-800 hover:to-teal-800 border border-[var(--color-accent,#d4a63a)]/70 px-4 py-2.5 rounded-2xl shadow-lg text-xs sm:text-sm min-h-[44px] text-[var(--color-accent,#d4a63a)] hover:shadow-xl"
        title="Acceder al Panel de Administración protegido"
      >
        <span class="p-1 rounded-lg bg-emerald-950/80 text-[var(--color-accent,#d4a63a)]">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.lock}></svg>
        </span>
        <span>Panel de administrador</span>
      </a>

    </nav>

    {/* Botón de Menú Móvil (Hamburguesa) */}
    <div class="flex items-center gap-2 md:hidden">
      <button 
        type="button" 
        id="mobileMenuToggle" 
        aria-label="Abrir menú de navegación móvil"
        aria-expanded="false"
        class="min-h-[44px] min-w-[44px] p-2.5 rounded-2xl bg-emerald-900/80 hover:bg-emerald-800 border border-emerald-500/50 text-white transition-all shadow-md flex items-center justify-center cursor-pointer"
      >
        <svg class="w-6 h-6 text-emerald-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

  </div>

  {/* Cajón de Menú Móvil Desplegable (Drawer) */}
  <div 
    id="mobileDrawer" 
    class="fixed inset-0 z-50 bg-black/75 backdrop-blur-md hidden transition-opacity duration-300 md:hidden"
    aria-hidden="true"
  >
    <div class="fixed top-0 right-0 w-[82%] max-w-xs h-full bg-[#0d2217] border-l border-emerald-700/60 p-6 flex flex-col justify-between shadow-2xl text-white overflow-y-auto">
      
      <div class="space-y-6">
        
        {/* Encabezado del menú móvil */}
        <div class="flex items-center justify-between border-b border-emerald-800/80 pb-4">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center border border-emerald-500/40">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.leaf}></svg>
            </div>
            <span class="font-black text-sm tracking-wider">CHOCÓ ANDINO</span>
          </div>
          <button 
            type="button" 
            id="mobileDrawerClose" 
            aria-label="Cerrar menú móvil"
            class="min-h-[44px] min-w-[44px] rounded-2xl bg-emerald-950 text-emerald-200 hover:text-white flex items-center justify-center text-xl font-black border border-emerald-800/60 cursor-pointer"
          >
            &times;
          </button>
        </div>

        {/* Enlaces de navegación móvil limpios y ordenados */}
        <nav class="space-y-3 text-sm font-bold" aria-label="Navegación móvil">
          
          <button 
            type="button" 
            class="js-open-aprende mobile-nav-link w-full flex items-center gap-3 bg-emerald-900/70 border border-emerald-600/50 p-3.5 rounded-2xl text-left text-emerald-100 min-h-[48px] shadow-sm cursor-pointer"
          >
            <span class="p-1.5 rounded-xl bg-emerald-700 text-[var(--color-accent,#d4a63a)]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.sparkles}></svg>
            </span>
            <span>Aprende (Asistente IA)</span>
          </button>

          <a 
            href="#catalogo" 
            class="mobile-nav-link flex items-center gap-3 bg-emerald-950/60 border border-emerald-800/50 p-3.5 rounded-2xl text-emerald-100 hover:text-white min-h-[48px] shadow-sm"
          >
            <span class="p-1.5 rounded-xl bg-emerald-900 text-emerald-300">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.leaf}></svg>
            </span>
            <span>Catálogo de Especies</span>
          </a>

          <a 
            href="/admin" 
            class="mobile-nav-link flex items-center gap-3 bg-gradient-to-r from-emerald-800 to-teal-800 border border-[var(--color-accent,#d4a63a)]/70 p-3.5 rounded-2xl text-white shadow-xl min-h-[48px] mt-4"
          >
            <span class="p-2 rounded-xl bg-[var(--color-deep,#14301f)] text-[var(--color-accent,#d4a63a)]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.lock}></svg>
            </span>
            <div class="flex flex-col">
              <span class="text-[10px] uppercase font-black text-[var(--color-accent,#d4a63a)] tracking-wider">Administración</span>
              <span class="text-xs sm:text-sm font-black">Panel de administrador</span>
            </div>
          </a>

        </nav>
      </div>

      <div class="pt-6 border-t border-emerald-800/60 text-center text-xs text-emerald-300 space-y-1">
        <p class="font-bold uppercase tracking-wider text-[11px]">Reserva de Biosfera UNESCO</p>
        <p class="text-[10px] text-zinc-400">Pichincha &bull; Ecuador</p>
      </div>

    </div>
  </div>

</header>
