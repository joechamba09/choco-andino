---
// src/components/Footer.astro
// Pie de página educativo e institucional para el proyecto de tesis Chocó Andino
const ic = {
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c2 2 2.6 3.5 3.7 9.2A7 7 0 0 1 11 20z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/><path d="M12 11c-2 2-3 4-3 6"/>',
  sparkles: '<path d="M9.9 2.9 11 6.7a2 2 0 0 0 1.3 1.3l3.8 1.1-3.8 1.1a2 2 0 0 0-1.3 1.3l-1.1 3.8-1.1-3.8a2 2 0 0 0-1.3-1.3L3.7 9.1 7.5 8a2 2 0 0 0 1.3-1.3z"/><path d="M19 14v4"/><path d="M17 16h4"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>'
};
---

<!-- 6. PIE DE PÁGINA INSTITUCIONAL Y EDUCATIVO -->
<footer class="w-full bg-[var(--color-deep,#14301f)] text-white border-t border-emerald-900/40 pt-16 pb-12 px-6 md:px-12 lg:px-16 relative overflow-hidden z-20">
  
  {/* Patrón sutil decorativo botánico en el fondo */}
  <div class="absolute inset-0 pointer-events-none opacity-5 flex justify-between items-center" aria-hidden="true">
    <svg class="w-96 h-96 -ml-20 text-emerald-300" viewBox="0 0 24 24" fill="currentColor">
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c2 2 2.6 3.5 3.7 9.2A7 7 0 0 1 11 20z"/>
    </svg>
    <svg class="w-96 h-96 -mr-20 text-emerald-300" viewBox="0 0 24 24" fill="currentColor">
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c2 2 2.6 3.5 3.7 9.2A7 7 0 0 1 11 20z"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-10 relative z-10">
    
    {/* Columna 1: Identidad y Misión Educativa */}
    <div class="md:col-span-5 space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-emerald-400 to-teal-600 rounded-2xl flex items-center justify-center text-white shadow-md border border-emerald-300/40">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.leaf}></svg>
        </div>
        <div>
          <span class="text-xl font-black tracking-wider text-white">CHOCÓ ANDINO</span>
          <span class="block text-[10px] uppercase tracking-widest text-emerald-300 font-bold">Pichincha &bull; Ecuador</span>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-emerald-200/90 leading-relaxed max-w-sm">
        Plataforma académica y de divulgación científica dedicada a la conservación y estudio de las especies de la Reserva de la Biosfera del Chocó Andino.
      </p>

      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-950/70 border border-[var(--color-accent,#d4a63a)]/50 text-[var(--color-accent,#d4a63a)] text-[11px] font-bold">
        <span>Reserva de Biosfera UNESCO</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent,#d4a63a)] animate-pulse"></span>
        <span class="text-emerald-300 font-medium">Desde 2018</span>
      </div>
    </div>

    {/* Columna 2: Navegación Rápida */}
    <div class="md:col-span-4 space-y-3">
      <h3 class="text-xs font-black uppercase tracking-widest text-[var(--color-accent,#d4a63a)] border-b border-emerald-800/80 pb-2">
        Navegación del Proyecto
      </h3>
      <ul class="space-y-2 text-sm text-emerald-100">
        <li>
          <a href="#catalogo" class="hover:text-[var(--color-accent,#d4a63a)] transition-colors inline-flex items-center gap-2">
            <span class="text-emerald-500">&rsaquo;</span>
            <span>Catálogo de 40 Especies</span>
          </a>
        </li>
        <li>
          <button type="button" class="js-open-aprende hover:text-[var(--color-accent,#d4a63a)] transition-colors inline-flex items-center gap-2 text-left cursor-pointer">
            <span class="text-emerald-500">&rsaquo;</span>
            <span>Asistente Interactivo IA (Aprende)</span>
          </button>
        </li>
        <li>
          <a href="/admin" class="hover:text-[var(--color-accent,#d4a63a)] transition-colors inline-flex items-center gap-2">
            <span class="text-emerald-500">&rsaquo;</span>
            <span>Panel de administrador</span>
          </a>
        </li>
      </ul>
    </div>

    {/* Columna 3: Información de Tesis y Defensa */}
    <div class="md:col-span-3 space-y-3">
      <h3 class="text-xs font-black uppercase tracking-widest text-[var(--color-accent,#d4a63a)] border-b border-emerald-800/80 pb-2">
        Presentación de Tesis
      </h3>
      <div class="text-xs text-emerald-200/80 space-y-1.5 leading-relaxed">
        <p class="font-bold text-white">Aplicación Web Educativa sobre Biodiversidad</p>
        <p>Desarrollada con Astro, JavaScript, SQLite y Leaflet.</p>
        <p class="text-[11px] text-emerald-400">Diseño responsive adaptable a móviles, tabletas y computadoras.</p>
      </div>
    </div>

  </div>

  {/* Barra de Derechos y Créditos */}
  <div class="max-w-7xl mx-auto mt-12 pt-6 border-t border-emerald-900/60 flex flex-col sm:flex-row justify-between items-center text-xs text-emerald-400 gap-3 text-center sm:text-left">
    <p>&copy; {new Date().getFullYear()} Chocó Andino de Pichincha &bull; Proyecto Educativo y Científico.</p>
    <p class="text-[11px] text-emerald-500">Diseñado para la conservación y divulgación de la Reserva de Biosfera.</p>
  </div>
</footer>
