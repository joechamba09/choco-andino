---
// src/components/SpeciesCard.astro
// Componente reutilizable para las tarjetas de especies del catálogo
import type { Especie } from '../data/especies';

interface Props {
  especie: Especie;
}

const { especie } = Astro.props;
const d = especie.data;

const ic = {
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c2 2 2.6 3.5 3.7 9.2A7 7 0 0 1 11 20z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/><path d="M12 11c-2 2-3 4-3 6"/>',
  bird: '<path d="M16 7h.01"/><path d="M3.4 18H12a8 8 0 0 0 8-8V7a4 4 0 0 0-7.28-2.3L2 20"/><path d="m20 7 2 .5-2 .5"/><path d="M10 18v3"/><path d="M14 17.75V21"/><path d="M7 18a6 6 0 0 0 3.84-10.61"/>',
  paw: '<circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/>',
  water: '<path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>',
  bug: '<path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/><path d="M6.53 9C4.6 8.8 3 7.1 3 5"/><path d="M6 13H2"/><path d="M17.47 9c1.93-.2 3.53-1.9 3.53-4"/><path d="M22 13h-4"/>',
  flower: '<circle cx="12" cy="12" r="3"/><path d="M12 16.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 1 1 4.5 4.5 4.5 4.5 0 1 1-4.5 4.5"/><path d="M12 7.5V9"/><path d="M7.5 12H9"/><path d="M16.5 12H15"/><path d="M12 16.5V15"/>'
};

const iconoCat = (cat: string) =>
  cat === 'Aves' ? ic.bird : cat === 'Mamíferos' ? ic.paw : cat === 'Anfibios' ? ic.water : cat === 'Insectos' ? ic.bug : ic.flower;
---

<a 
  href={`/especies/${especie.id}`}
  data-id={especie.id}
  data-name={d.nombre.toLowerCase()} 
  data-scientific={d.nombreCientifico.toLowerCase()}
  data-category={d.categoria}
  class="species-card cho-card cho-reveal w-full bg-white rounded-[28px] overflow-hidden border border-emerald-100 hover:border-[var(--color-secondary,#2e7d52)] transition-all duration-300 shadow-md hover:shadow-xl flex flex-col group text-left no-underline cursor-pointer"
>
  {/* Contenedor de Fotografía Verificada */}
  <div class="relative h-48 w-full overflow-hidden bg-zinc-100">
    <img 
      src={d.imagen} 
      alt={d.altImagen || d.nombre} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
      loading="lazy" 
    />
    <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-md text-emerald-950 text-[10px] font-black px-3 py-1 rounded-full border border-emerald-200 shadow-md inline-flex items-center gap-1.5 uppercase tracking-wider">
      <svg class="w-3.5 h-3.5 text-[var(--color-secondary,#2e7d52)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconoCat(d.categoria)}></svg>
      {d.categoria}
    </span>
  </div>

  {/* Detalles y Metadatos de la Especie */}
  <div class="p-5 flex flex-col flex-grow space-y-3">
    <div>
      <h4 class="text-base font-black text-[var(--color-ink,#1b2a22)] group-hover:text-[var(--color-secondary,#2e7d52)] transition-colors leading-tight">
        {d.nombre}
      </h4>
      <p class="text-[11px] italic text-emerald-800 font-serif font-medium mt-0.5">
        {d.nombreCientifico}
      </p>
    </div>

    <div class="space-y-1.5 text-xs text-zinc-600 pt-3 border-t border-emerald-50 mt-auto">
      <p>
        <strong class="text-zinc-500 font-bold">Conservación:</strong> 
        <span class="text-amber-800 font-semibold">{d.estadoConservacion}</span>
      </p>
      <p class="truncate" title={d.habitat}>
        <strong class="text-zinc-500 font-bold">Hábitat:</strong> {d.habitat}
      </p>

      {/* Botón de acción hacia la ficha completa */}
      <div class="pt-2">
        <span class="btn-ficha-completa w-full inline-flex items-center justify-between text-xs font-bold text-emerald-800 group-hover:text-white bg-emerald-50 group-hover:bg-[var(--color-primary,#1e4d36)] px-3.5 py-2.5 rounded-xl transition-all border border-emerald-200/80 group-hover:border-transparent shadow-sm">
          <span>Ver ficha completa</span>
          <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
        </span>
      </div>
    </div>
  </div>
</a>
