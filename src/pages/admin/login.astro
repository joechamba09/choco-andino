---
import Layout from '../../layouts/Layout.astro';
import { verifySession } from '../../db/auth';

export const prerender = false;

// Si ya tiene sesión activa, redirigir directo al panel
const token = Astro.cookies.get('choco_session')?.value;
const user = verifySession(token);
if (user) {
  return Astro.redirect('/admin');
}
---

<Layout title="Acceso al Panel de Administración | Chocó Andino">
  <main class="w-full min-h-screen bg-[var(--cho-cream,#faf6ea)] text-[var(--cho-ink,#1b2a22)] flex flex-col justify-center items-center p-4 sm:p-6 relative overflow-hidden selection:bg-emerald-700 selection:text-white">
    
    {/* Resplandores ambientales y fondo de naturaleza */}
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-emerald-300/30 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-amber-200/30 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10 space-y-6">
      
      {/* Encabezado e Isotipo */}
      <div class="text-center space-y-2">
        <a href="/" class="inline-flex items-center justify-center p-3.5 bg-gradient-to-br from-emerald-500 to-teal-700 rounded-[22px_8px_22px_8px] text-white shadow-xl shadow-emerald-950/20 hover:scale-105 transition-transform border border-emerald-300/40">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c2 2 2.6 3.5 3.7 9.2A7 7 0 0 1 11 20z"></path>
            <path d="M2 21c0-3 1.85-5.36 5.08-6"></path>
            <path d="M12 11c-2 2-3 4-3 6"></path>
          </svg>
        </a>
        <h1 class="text-2xl sm:text-3xl font-black text-[var(--cho-deep,#14301f)] tracking-tight">
          Panel de Administración
        </h1>
        <p class="text-xs sm:text-sm text-zinc-600 font-medium">
          Gestión del Catálogo de Biodiversidad del Chocó Andino
        </p>
      </div>

      {/* Tarjeta de Inicio de Sesión */}
      <div class="bg-white/95 backdrop-blur-md border border-emerald-200/90 rounded-[28px] p-6 sm:p-8 shadow-2xl shadow-emerald-950/10 space-y-6">
        
        <div id="alertBox" class="hidden p-3.5 rounded-2xl text-xs font-bold border transition-all"></div>

        <form id="loginForm" class="space-y-4">
          
          <div class="space-y-1.5">
            <label for="username" class="block text-xs font-black uppercase tracking-wider text-[var(--cho-forest,#1e4d36)]">
              Usuario Administrador
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-emerald-700 pointer-events-none">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </span>
              <input 
                type="text" 
                id="username" 
                name="username" 
                required 
                autocomplete="username"
                placeholder="admin"
                class="w-full bg-stone-50 border border-emerald-200 rounded-2xl pl-10 pr-4 py-3 text-sm text-zinc-900 focus:outline-none focus:border-emerald-500 focus:bg-white transition-all shadow-inner"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="password" class="block text-xs font-black uppercase tracking-wider text-[var(--cho-forest,#1e4d36)]">
              Contraseña
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-emerald-700 pointer-events-none">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </span>
              <input 
                type="password" 
                id="password" 
                name="password" 
                required 
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full bg-stone-50 border border-emerald-200 rounded-2xl pl-10 pr-4 py-3 text-sm text-zinc-900 focus:outline-none focus:border-emerald-500 focus:bg-white transition-all shadow-inner"
              />
            </div>
          </div>

          <button 
            type="submit" 
            id="submitBtn"
            class="w-full min-h-[48px] bg-[var(--cho-forest,#1e4d36)] hover:bg-[var(--cho-deep,#14301f)] text-white font-black py-3 px-6 rounded-2xl text-sm transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2 cursor-pointer mt-2"
          >
            <span>Iniciar Sesión</span>
            <svg class="w-4 h-4 text-[var(--cho-gold,#d4a63a)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </button>

        </form>

        <div class="pt-2 border-t border-emerald-100 flex items-center justify-between text-xs text-zinc-500">
          <a href="/" class="hover:text-[var(--cho-forest,#1e4d36)] font-bold transition-colors inline-flex items-center gap-1">
            &larr; Volver a la web pública
          </a>
          <span class="text-emerald-700 font-medium">Acceso Seguro</span>
        </div>

      </div>

      {/* Nota de credenciales predeterminadas para entorno local */}
      <div class="bg-emerald-50/80 border border-emerald-200/80 rounded-2xl p-3.5 text-center text-xs text-emerald-900">
        <span class="font-bold">Credenciales predeterminadas del primer inicio:</span>
        <div class="font-mono text-[11px] text-emerald-950 mt-1">Usuario: <strong>admin</strong> | Clave: <strong>ChocoAndino2026!</strong></div>
      </div>

    </div>

  </main>

  <script>
    const form = document.getElementById('loginForm') as HTMLFormElement;
    const alertBox = document.getElementById('alertBox')!;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.classList.add('hidden');
      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>Verificando...</span>';

      const username = (document.getElementById('username') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password }),
        });

        const data = await res.json();

        if (res.ok && data.ok) {
          alertBox.className = 'p-3.5 rounded-2xl text-xs font-bold border bg-emerald-100 text-emerald-900 border-emerald-300 block';
          alertBox.textContent = '¡Acceso concedido! Redirigiendo al panel...';
          setTimeout(() => {
            window.location.href = '/admin';
          }, 400);
        } else {
          alertBox.className = 'p-3.5 rounded-2xl text-xs font-bold border bg-rose-100 text-rose-900 border-rose-300 block';
          alertBox.textContent = data.error || 'Credenciales inválidas. Verifica tu usuario y contraseña.';
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      } catch (err) {
        alertBox.className = 'p-3.5 rounded-2xl text-xs font-bold border bg-rose-100 text-rose-900 border-rose-300 block';
        alertBox.textContent = 'Error al conectar con el servidor. Revisa tu conexión.';
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  </script>
</Layout>
